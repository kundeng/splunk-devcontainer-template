        "inputs": {
            "services": [
                {
                    "name": "urc_app_input",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Input Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for the data input.",
                            "required": true
                        },
                        {
                            "type": "singleSelect",
                            "label": "Account",
                            "options": {
                                "referenceName": "account"
                            },
                            "help": "Account to use for this input.",
                            "field": "account",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Base URL",
                            "field": "base_url",
                            "help": "API base URL (e.g., https://api.example.com/v1). Used in manifest as {{ config['base_url'] }}.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Must be a valid URL starting with http:// or https://",
                                    "pattern": "^https?://.+"
                                }
                            ]
                        },
                        {
                            "type": "textarea",
                            "label": "Manifest",
                            "field": "manifest",
                            "help": "Airbyte declarative manifest YAML defining streams, pagination, record extraction, and incremental sync.",
                            "required": true,
                            "options": {
                                "rowsMin": 10,
                                "rowsMax": 50
                            }
                        },
                        {
                            "type": "interval",
                            "label": "Interval",
                            "defaultValue": "300",
                            "field": "interval",
                            "options": {
                                "range": [
                                    10,
                                    86400
                                ]
                            },
                            "help": "Collection interval in seconds.",
                            "required": true
                        },
                        {
                            "type": "index",
                            "field": "index",
                            "label": "Index"
                        },
                        {
                            "type": "text",
                            "label": "Sourcetype",
                            "field": "sourcetype",
                            "help": "Event sourcetype.",
                            "defaultValue": "urc:api:json",
                            "required": false
                        }
                    ],
                    "inputHelperModule": "urc_app_input_helper",
                    "title": "REST API Input"
                }
            ],
            "title": "Inputs",
            "description": "Manage your data inputs",
            "table": {
                "actions": [
                    "edit",
                    "delete",
                    "clone"
                ],
                "header": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Base URL",
                        "field": "base_url"
                    },
                    {
                        "label": "Interval",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Status",
                        "field": "disabled"
                    }
                ],
                "moreInfo": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Base URL",
                        "field": "base_url"
                    },
                    {
                        "label": "Interval",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Sourcetype",
                        "field": "sourcetype"
                    },
                    {
                        "label": "Status",
                        "field": "disabled",
                        "mapping": {
                            "true": "Inactive",
                            "false": "Active"
                        }
                    }
                ]
            }
        },
        "dashboard": {
            "panels": [
                {
                    "name": "default"
                }
            ]
