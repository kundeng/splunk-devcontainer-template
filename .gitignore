# AI workflow tooling — not part of the template
.windloop/
.ck/

# Environment variables
/.env

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node.js
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# React monorepo — track source, ignore build artifacts + deps
apps/*/react/node_modules/
apps/*/react/packages/*/node_modules/
apps/*/react/packages/*/stage/
apps/*/react/packages/*/*.js
apps/*/react/packages/*/*.js.map
apps/*/react/packages/*/types/
apps/*/react/packages/*/demo/splunk-app/appserver/static/
apps/*/react/packages/*/coverage_report/
apps/*/react/packages/*/test-reports/

# Splunk
local/
**/metadata/local.meta
default.old*/
*.spl
*.tar.gz

# User apps — template ships only splunk-config-dev
infra/config/*
!infra/config/splunk-config-dev/
!infra/config/.gitkeep

# Docker
.docker/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory
.Trash-*

# Task
.task/

# Logs
logs/
*.log

# AI agent state
project_rules/**
memory/**
/.windsurf/
/.claude/

infra/deps/stage/*
!infra/deps/stage/.gitkeep

# Build output (generated, rebuild from source)
output/

# Playwright test artifacts
test-results/
playwright-report/

# Spec workflow approvals (generated)
.spec-workflow/approvals/

# Reference repos (cloned for study, not committed)
.ref/
