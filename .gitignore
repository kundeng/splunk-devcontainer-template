# Environment variables
/.env

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node.js
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# React monorepo — track source, ignore build artifacts + deps
react/node_modules/
react/packages/*/node_modules/
react/packages/*/stage/
react/packages/*/*.js
react/packages/*/*.js.map
react/packages/*/types/
react/packages/*/demo/splunk-app/appserver/static/
react/packages/*/coverage_report/
react/packages/*/test-reports/

# Splunk
local/
**/metadata/local.meta
default.old*/
*.spl
*.tar.gz

# User apps — template ships only splunk-config-dev
splunk/config/apps/*
!splunk/config/apps/splunk-config-dev/
!splunk/config/apps/.gitkeep

# Docker
.docker/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory
.Trash-*

# Task
.task/

# Logs
logs/
*.log

project_rules/**
memory/**
/.windsurf/
/.claude/*
!/.claude/memory/
!/.claude/settings.local.json

splunk/stage/*
!splunk/stage/.gitkeep

# UCC build output (generated, rebuild from source)
ucc/output/

# Playwright test artifacts
test-results/
playwright-report/

# Spec workflow approvals (generated)
.spec-workflow/approvals/

# Reference repos (cloned for study, not committed)
.ref/
