{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Splunk App in Chrome",
            "url": "http://localhost:8000/en-US/app/${input:appName}/",
            "webRoot": "${workspaceFolder}/splunk/config/apps/${input:appName}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug React Dev Server",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/packages/${input:appName}/src"
        }
    ],
    "inputs": [
        {
            "id": "appName",
            "description": "Enter the name of your Splunk app",
            "default": "my_app",
            "type": "promptString"
        }
    ]
}